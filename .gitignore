# Unity .gitignore — place this in the Unity project root
# (the same folder that contains Assets/, Library/, Packages/ and ProjectSettings/)
# Based on https://github.com/github/gitignore/blob/main/Unity.gitignore

# ---- Unity generated folders ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size and may contain sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---- IDE / editor files ----
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/

# Autogenerated VS/MD/Consulo solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.rsuser
*.DotSettings.user

# Unity3D generated file on crash reports
sysinfo.txt
mono_crash.*

# Crashlytics generated file
crashlytics-build.properties

# ---- Builds ----
*.apk
*.aab
*.unitypackage
*.app

# ---- Addressables ----
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- OS files ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Unity player builds ----
# The rules above only cover /Build/ and /Builds/. A build written anywhere else
# drops <Name>.exe next to <Name>_Data/, MonoBleedingEdge/, UnityPlayer.dll and
# the graphics runtimes, which is how ~2.7 GB of build output ended up committed
# under Results3/. These are regenerable artefacts and never belong in the repo.
*_Data/
MonoBleedingEdge/
D3D12/
UnityPlayer.dll
UnityCrashHandler*.exe
WinPixEventRuntime.dll
*.exe

# ---- Analysis and measurement outputs ----
# Every Results* folder: the geometric assessment outputs, the raw per-frame
# benchmark data, and (under Results3) a Unity player build. All kept out of the
# repository and archived separately.
Results*/
